<%# 
    EJS 标签使用规范:
    - <% ... %>: '脚本'标签, 用于执行无输出的JavaScript代码 (如: 变量声明, if/for等流程控制)。
    - <%- ... %>: '非转义输出'标签, 用于将变量或表达式的结果直接输出为原始HTML/文本。
    - <%= ... %>: '转义输出'标签, 用于输出变量, 并对HTML特殊字符进行转义 (如: < 变为 &lt;)。
    - <%# ... %>: '注释'标签, 其中的内容会被完全忽略。
    - print(...): 是一个内置函数, 可以在 <% ... %> 脚本块内调用来产生输出。
    
    核心原则: 逻辑和声明必须在 <% ... %> 内, 只有直接的输出值才在 <%- ... %> 或 <%= ... %> 内。
%>
<%
    const worldState = getvar('stat_data');
    let player, allCharacters, chronicle, globalState, activeChars = [], nearbyChars = [], unloadedChars = [];

    // --- 防御性编程 V2 ---
    // 先判断核心数据是否存在，再执行后续逻辑
    if (worldState && worldState.global && worldState.player && worldState.characters && worldState.chronicle) {
        
        // --- 本地变量定义 ---
        player = worldState.player;
        allCharacters = worldState.characters;
        chronicle = worldState.chronicle;
        globalState = worldState.global;

        // --- 角色分类逻辑 ---
        for (const charName in allCharacters) {
            if (charName.startsWith('_TEMPLATE_')) continue;
            const character = allCharacters[charName];
            const turnsSinceUpdate = character._internal ? (character._internal.turns_since_last_update || 0) : 0;
            
            if (turnsSinceUpdate <= 5) {
                activeChars.push({ name: charName, character: character });
            } else if (turnsSinceUpdate <= 15) {
                nearbyChars.push({ name: charName, character: character });
            } else {
                unloadedChars.push({ name: charName, character: character });
            }
        }
    }
%>
[全局状态]
当前时间: <%- globalState?.time || '未知' %>
当前地点: <%- globalState?.location ? `${globalState.location.region}, ${globalState.location.city}, ${globalState.location.area}, ${globalState.location.spot}` : '未知' %>
天气: <%- globalState?.weather || '未知' %>
环境: <%- globalState?.environment_status || '未知' %>
游戏总轮次: <%- globalState?.game_progress?.total_turns || 0 %>
在场角色: <%- (globalState?.presence?.active_chars || []).join(', ') || '无' %>
附近角色: <%- (globalState?.presence?.nearby_chars || []).join(', ') || '无' %>

<%# ================================= Player ================================= %>
<% if (player) { %>
[玩家档案: <%- player.profile.name %>]
<% print(JSON.stringify(_.omit(player, ['_internal']), null, 2)); %>
<% } else { %>
[玩家档案: 未找到数据]
<% } %>

<%# ================================= Characters ================================= %>
[角色档案]

<% if (activeChars.length > 0) { %>
--- 在场角色 (Active) ---
<% activeChars.forEach(char => { %>
<%- `## ${char.name}` %>
<%
    // 扁平化后的结构，直接使用 char.character，并过滤内部字段
    print(JSON.stringify(_.omit(char.character, ['_internal', 'has_static_profile']), null, 2));
%>
<% }); %>
<% } %>

<% if (nearbyChars.length > 0) { %>
--- 附近角色 (Nearby) ---
<% nearbyChars.forEach(char => { %>
<%- `## ${char.name}` %>
<%
    // 扁平化后的结构，直接检查 profile
    if (char.character.profile) {
        print(JSON.stringify(char.character.profile, null, 2));
    } else {
        print(`(档案未生成)`);
    }
%>
<% }); %>
<% } %>

<% if (unloadedChars.length > 0) { %>
--- 已不在场的角色 (Unloaded) ---
<%- unloadedChars.map(char => char.name).join(', ') %>
<% } %>

<%# ================================= Chronicle ================================= %>
<% if (chronicle) { %>
[历史回顾 (Chronicle)]

<% if (chronicle.round_buffer && chronicle.round_buffer.length > 0) { %>
## 轮次记忆 (Last <%- chronicle.round_buffer.length %> Turns)
<% print(JSON.stringify(chronicle.round_buffer, null, 2)) %>
<% } %>

<% if (chronicle.small_summary_buffer && chronicle.small_summary_buffer.length > 0) { %>
## 十轮总结
<% print(JSON.stringify(chronicle.small_summary_buffer, null, 2)) %>
<% } %>

<% if (chronicle.daily_summary_buffer && chronicle.daily_summary_buffer.length > 0) { %>
## 每日总结
<% print(JSON.stringify(chronicle.daily_summary_buffer, null, 2)) %>
<% } %>

<% if (chronicle.weekly_summary_buffer && chronicle.weekly_summary_buffer.length > 0) { %>
## 每周总结
<% print(JSON.stringify(chronicle.weekly_summary_buffer, null, 2)) %>
<% } %>

<% if (chronicle.monthly_summary_buffer && chronicle.monthly_summary_buffer.length > 0) { %>
## 每月总结
<% print(JSON.stringify(chronicle.monthly_summary_buffer, null, 2)) %>
<% } %>

<% if (chronicle.yearly_summary_buffer && chronicle.yearly_summary_buffer.length > 0) { %>
## 年度总结
<% print(JSON.stringify(chronicle.yearly_summary_buffer, null, 2)) %>
<% } %>

<% } %>

<%# 
    此 EJS 模板旨在为 plot AI 提供一个补充性的上下文。
    它专门筛选出那些拥有静态世界书档案（`has_static_profile: true`）
    且当前在场（`turns_since_last_update <= 5`）的角色，
    并仅展示他们的动态信息（如状态、认知、记忆），
    作为对静态档案的实时状态补全。
%>
<%
    const worldState_static = getvar('stat_data');

    // --- 防御性编程 V2 ---
    // 先判断核心数据是否存在，再执行后续逻辑
    if (worldState_static && worldState_static.characters) {
        const allChars_static = worldState_static.characters;
        const staticChars = [];
        
        // --- 筛选逻辑 ---
        for (const charName in allChars_static) {
            if (charName.startsWith('_TEMPLATE_')) continue;
            const char = allChars_static[charName];
            
            // 必须是静态档案角色
            if (char.has_static_profile !== true) continue;

            // 仅针对在场角色 (<= 5 turns)
            const turns = char._internal ? (char._internal.turns_since_last_update || 0) : 0;
            if (turns <= 5) {
                staticChars.push({ name: charName, data: char });
            }
        }
        
        // --- 渲染逻辑 ---
        if (staticChars.length > 0) {
            print('[角色动态状态补全]');
            staticChars.forEach(item => {
                print(`\n## ${item.name}`);
                // 提取动态字段: 排除 profile, _internal, has_static_profile
                // 这部分数据是对 Worldbook 静态描述的实时补充
                print(JSON.stringify(_.omit(item.data, ['profile', '_internal', 'has_static_profile']), null, 2));
            });
        }
    }
%>
<%
    var worldState_update = getvar('stat_data');
    var characters_filtered = {};

    if (worldState_update && worldState_update.characters) {
        // 使用 lodash 的 omitBy 来过滤掉所有以 _TEMPLATE_ 开头的键
        characters_filtered = _.omitBy(worldState_update.characters, (value, key) => key.startsWith('_TEMPLATE_'));
    }
%>
[全局状态]
{{format_message_variable::stat_data.global}}

[玩家档案]
{{format_message_variable::stat_data.player}}

[角色档案]
<% print(JSON.stringify(characters_filtered, null, 2)); %>

[历史回顾 (Chronicle)]
{{format_message_variable::stat_data.chronicle}}